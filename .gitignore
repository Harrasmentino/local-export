!/credential_store.py
!/macos_credentials.py
!/platform_paths.py
!/links.example.txt
!/fetch_pages.py
!/local_export.py
!/local_documents.py
!/windows_credentials.py
!/parser.py
!/extract_expands.py
!/VYGRUZKA.bat
!/run.bat
!/ZAPUSK.bat

!/_local/
